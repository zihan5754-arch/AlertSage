        {"text": "regex:(?i)%2e%2e%2f"}
      ]
    },
    "recommendations": [
      "检查文件读取接口的路径规范化（realpath 校验）",
      "确认是否读到敏感文件，评估影响面",
      "封禁来源 IP 并加入监控"
    ]
  },
  {
    "id": "WEB-LFI-001",
    "title": "本地/远程文件包含与伪协议利用",
    "severity": "high",
    "category": "web",
    "confidence": 0.84,
    "mitre": ["T1006"],
    "description": "出现 php://filter、file://、data:// 等协议包装器或直接包含系统文件。",
