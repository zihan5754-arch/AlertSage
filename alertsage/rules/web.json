        {"text": "regex:(?i)(metadata/|latest/meta-data)"},
        {"text": "regex:(?i)(\\?|&)(url|target|redirect|next|img)=https?://(127\\.0\\.0\\.1|localhost|10\\.|192\\.168\\.)"}
      ]
    },
    "recommendations": [
      "确认服务端是否对 url 参数做了白名单/内网地址校验",
      "检查是否已获取到云凭证（重点看 169.254.169.254 的响应）",
      "封禁来源 IP，收紧出口访问策略"
    ]
  },
  {
