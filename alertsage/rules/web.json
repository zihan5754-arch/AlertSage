      ]
    },
    "recommendations": [
      "限制文件包含的参数白名单",
      "检查 include/require 是否拼接了用户输入",
      "确认是否有文件被写入或外带"
    ]
  },
  {
    "id": "WEB-SSRF-001",
    "title": "SSRF - 探测云元数据/内网服务",
    "severity": "high",
    "category": "web",
    "confidence": 0.82,
    "mitre": ["T1090"],
    "description": "参数中出现 169.254.169.254 元数据地址或 gopher/dict 协议。",
    "match": {
      "any": [
        {"text": "regex:(?i)169\\.254\\.169\\.254"},
