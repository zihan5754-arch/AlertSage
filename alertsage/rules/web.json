[
  {
    "id": "WEB-SQLI-001",
    "title": "SQL 注入 - 布尔/联合永真式",
    "severity": "high",
    "category": "web",
    "confidence": 0.86,
    "mitre": ["T1190"],
    "description": "请求中出现 union select 或永真式闭合，属于最典型的注入探测/利用特征。",
    "match": {
      "any": [
        {"text": "regex:(?i)(union(\\s|/\\*.*?\\*/)+select)"},
        {"text": "regex:(?i)('|\"|%27)\\s*(or|and)\\s+('?\\d+'?)\\s*=\\s*('?\\d+'?)"},
        {"text": "regex:(?i)(or|and)\\s+1\\s*=\\s*1"},
        {"text": "regex:(?i)\\bwaitfor\\s+delay\\b"}
      ]
    },
    "recommendations": [
      "确认目标参数是否使用参数化查询，检查是否存在注入点",
      "对来源 IP 临时封禁（WAF 策略或防火墙）",
      "回溯该 IP 在近 24h 的请求，确认是否有成功注出数据的痕迹"
    ]
  },
  {
    "id": "WEB-SQLI-002",
    "title": "SQL 注入 - 时间盲注",
    "severity": "critical",
    "category": "web",
    "confidence": 0.9,
    "mitre": ["T1190"],
    "description": "sleep()/benchmark()/pg_sleep() 等延时函数被注入，通常是盲注工具在跑。",
    "match": {
      "any": [
        {"text": "regex:(?i)(sleep|benchmark|pg_sleep)\\s*\\(\\s*\\d+"},
        {"text": "regex:(?i)extractvalue\\s*\\(|updatexml\\s*\\("}
      ]
    },
    "recommendations": [
      "立即确认该接口是否可注入，必要时下线接口",
      "封禁来源 IP 并通知业务方",
      "检查数据库审计日志中是否有异常长查询"
    ]
  },
  {
    "id": "WEB-XSS-001",
    "title": "跨站脚本（XSS）注入",
    "severity": "high",
    "category": "web",
    "confidence": 0.75,
    "mitre": ["T1059.007"],
    "description": "参数中出现 script 标签、事件处理器或 javascript: 伪协议。",
    "match": {
      "any": [
        {"text": "regex:(?i)<\\s*script[^>]*>"},
        {"text": "regex:(?i)\\bon(error|load|click|mouseover)\\s*="},
        {"text": "regex:(?i)javascript\\s*:"},
        {"text": "regex:(?i)<\\s*(svg|img|iframe)[^>]*(on\\w+)?\\s*="}
      ]
    },
    "recommendations": [
      "核对输出编码是否到位（HTML 实体编码 / CSP）",
      "确认 payload 是否被执行（看响应体是否原样回显）",
      "对高频来源 IP 加验证码或限流"
    ]
  },
  {
    "id": "WEB-CMDI-001",
    "title": "命令注入",
    "severity": "critical",
    "category": "web",
    "confidence": 0.88,
    "mitre": ["T1059.004"],
    "description": "参数中拼接了 shell 元字符与系统命令（whoami/cat/curl 等）。",
    "match": {
      "any": [
        {"text": "regex:(?i)[;|&`$]\\s*(whoami|id|uname|cat|ls|curl|wget|bash|sh|nc|ping)\\b"},
        {"text": "regex:(?i)\\$\\(\\s*(whoami|id|cat|curl|wget)\\b"},
        {"text": "regex:(?i)\\|\\|\\s*(wget|curl)\\s+http"}
      ]
    },
    "recommendations": [
      "定位命令执行接口，检查是否过滤了 shell 元字符",
      "封禁来源 IP，确认服务器是否有异常进程/外连",
      "排查是否有写入型痕迹（临时目录、cron、计划任务）"
    ]
  },
  {
    "id": "WEB-PATH-001",
    "title": "路径穿越",
    "severity": "high",
    "category": "web",
    "confidence": 0.8,
    "mitre": ["T1083"],
    "description": "出现 ../ 或编码后的穿越序列，尝试读取 Web 根目录之外的文件。",
    "match": {
