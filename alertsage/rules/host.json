        {"text": "regex:(?i)bash\\s+-i\\s+>&"},
        {"text": "regex:(?i)python[0-9.]*\\s+-c\\s+['\"]?import\\s+socket"}
      ]
    },
    "recommendations": [
      "立即断网隔离，保留内存镜像",
      "查外连目标 IP 是否在情报库中命中",
      "排查同源主机是否存在相同的持久化"
    ]
  },
